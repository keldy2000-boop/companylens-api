# ── Companies House ──────────────────────────────────────────────
# Free API key from: https://developer.company-information.service.gov.uk
CH_API_KEY=your_companies_house_api_key_here

# ── Anthropic Claude ─────────────────────────────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Algorand wallet ──────────────────────────────────────────────
# Your Algorand mainnet address (opted into USDC ASA 31566704)
# This is the address payments land in — keep it consistent throughout competition
WALLET_ADDRESS=your_algorand_wallet_address_here

# ── x402 / GoPlausible ───────────────────────────────────────────
# Testnet facilitator (no auth required — use for development)
FACILITATOR_URL=https://facilitator.goplausible.xyz
# Network: ALGORAND_Testnet_CAIP2 for dev, ALGORAND_Mainnet_CAIP2 for production
ALGORAND_NETWORK=ALGORAND_Mainnet_CAIP2
# USDC ASA: 10458941 (testnet) or 31566704 (mainnet)
USDC_ASA_ID=31566704

# ── Server ───────────────────────────────────────────────────────
PORT=3000
# Your deployed domain (needed for Bazaar discovery)
SERVICE_DOMAIN=https://api.companylens.xyz
